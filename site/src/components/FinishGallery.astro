---
// The same scene in several frame finishes. Radio buttons switch the picture without any JavaScript.
import { Image, Picture } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  name: string
  items: { finish: string; src: ImageMetadata }[]
  /** Optional close-ups; each part has one image per finish, in the same order as items. */
  hardware?: { name: string; images: ImageMetadata[] }[]
  /** Matches the product card, so the picture moves from the card into place on page change. */
  transitionName?: string
}
const { name, items, hardware, transitionName } = Astro.props
const slug = (s: string) => s.toLowerCase().replace(/[^a-z]+/g, '-')
---

<figure class="gallery" data-finish-cycle>
  <div class="stage" style={`aspect-ratio:${items[0].src.width} / ${items[0].src.height}${transitionName ? `;view-transition-name:${transitionName}` : ''}`}>
    {items.map((it, i) => (
      <Picture
        src={it.src}
        formats={['avif', 'webp']}
        widths={[480, 760, 1080, 1520]}
        sizes="(min-width: 64rem) 58vw, 100vw"
        alt={`${name} with a ${it.finish.toLowerCase()} frame`}
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : undefined}
        class="shot"
        pictureAttributes={{ class: `pic pic-${slug(it.finish)}`, 'data-index': String(i) }}
      />
    ))}
  </div>
  <figcaption>
    <fieldset>
      <legend>Try the frame finishes</legend>
      <div class="swatches">
        {items.map((it, i) => (
          <label class={`swatch swatch-${slug(it.finish)}`}>
            <input type="radio" name="gallery-finish" value={slug(it.finish)} checked={i === 0} />
            <span class="chip" aria-hidden="true" />
            <span class="label">{it.finish}</span>
          </label>
        ))}
      </div>
    </fieldset>
    {
      hardware && (
        <div class="hardware">
          <p class="hw-title">Hardware in the chosen finish</p>
          <ul class="hw-list" style={`--parts:${hardware.length}`}>
            {hardware.map((part) => (
              <li>
                <span class="hw-pics">
                  {part.images.map((src, i) => (
                    <Image src={src} alt="" widths={[160, 240, 320]} sizes="(min-width: 64rem) 9vw, 22vw" class={`hw hw-${slug(items[i].finish)}`} data-index={String(i)} />
                  ))}
                </span>
                <span class="hw-name">{part.name}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </figcaption>
</figure>

<script>
  import '../scripts/finish-cycle'
</script>

<style>
  .gallery {
    margin: 0;
  }

  .stage {
    position: relative;
    overflow: hidden;
    background: var(--stone);
    view-transition-class: product-pic;
  }

  .stage :global(.pic),
  .stage :global(.shot) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .stage :global(.shot) {
    object-fit: cover;
  }

  .stage :global(.pic) {
    opacity: 0;
    transition: opacity 420ms ease;
  }

  .stage :global(.pic[data-index='0']) {
    opacity: 1;
  }

  .gallery:has(input[value='brushed-gold']:checked) :global(.pic-brushed-gold),
  .gallery:has(input[value='brushed-silver']:checked) :global(.pic-brushed-silver),
  .gallery:has(input[value='polished-chrome']:checked) :global(.pic-polished-chrome),
  .gallery:has(input[value='matte-black']:checked) :global(.pic-matte-black) {
    opacity: 1;
  }

  .gallery:has(input:not([value='matte-black']):checked) :global(.pic-matte-black) {
    opacity: 0;
  }

  /* Hardware close-ups follow the chosen finish, the same way as the main picture. */
  .hardware {
    margin-top: var(--s-24);
  }

  .hw-title {
    margin-bottom: var(--s-12);
    color: var(--ink);
    font-size: var(--t-14);
    font-weight: 560;
  }

  .hw-list {
    display: grid;
    grid-template-columns: repeat(var(--parts), minmax(0, 1fr));
    gap: var(--s-12);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hw-list li {
    display: grid;
    gap: var(--s-8);
    align-content: start;
  }

  .hw-pics {
    position: relative;
    display: block;
    aspect-ratio: 1;
    border-radius: var(--radius);
    background: var(--stone);
  }

  .hw-pics :global(.hw) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 10%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 420ms ease;
  }

  .hw-pics :global(.hw[data-index='0']) {
    opacity: 1;
  }

  .gallery:has(input[value='brushed-gold']:checked) :global(.hw-brushed-gold),
  .gallery:has(input[value='brushed-silver']:checked) :global(.hw-brushed-silver),
  .gallery:has(input[value='polished-chrome']:checked) :global(.hw-polished-chrome),
  .gallery:has(input[value='matte-black']:checked) :global(.hw-matte-black) {
    opacity: 1;
  }

  .gallery:has(input:not([value='matte-black']):checked) :global(.hw-matte-black) {
    opacity: 0;
  }

  .hw-name {
    color: var(--graphite);
    font-size: var(--t-14);
    line-height: 1.35;
  }

  fieldset {
    margin: var(--s-16) 0 0;
    padding: 0;
    border: 0;
  }

  legend {
    padding: 0;
    margin-bottom: var(--s-12);
    color: var(--ink);
    font-size: var(--t-14);
    font-weight: 560;
  }

  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-8);
  }

  /* Each finish is a pill button; the chosen one is filled. */
  .swatch {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--s-8);
    min-height: 2.75rem;
    padding: 0 var(--s-16) 0 var(--s-8);
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 200ms ease, border-color 200ms ease;
  }

  .swatch:hover {
    background: var(--pill);
    border-color: var(--pill-current);
  }

  .swatch input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .chip {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.18);
  }

  .label {
    color: var(--ink);
    font-size: var(--t-14);
    font-weight: 560;
    transition: color 200ms ease;
  }

  .swatch:has(input:checked) {
    background: var(--ink);
    border-color: var(--ink);
  }

  .swatch:has(input:checked) .chip {
    box-shadow: 0 0 0 2px var(--white);
  }

  .swatch input:checked ~ .label {
    color: var(--white);
  }

  .swatch:has(input:focus-visible) {
    outline: 2px solid var(--glass);
    outline-offset: 2px;
  }

  .swatch-matte-black .chip {
    background: linear-gradient(135deg, #3a3c3f, #17181a);
  }

  .swatch-brushed-gold .chip {
    background: linear-gradient(135deg, #e3c88f, #b08a4f 55%, #d9bd84);
  }

  .swatch-brushed-silver .chip {
    background: linear-gradient(135deg, #e4e6e7, #a9adb0 55%, #d5d8da);
  }

  .swatch-polished-chrome .chip {
    background: linear-gradient(135deg, #ffffff, #9aa3a9 45%, #f2f4f5 60%, #7f878c);
  }

</style>
