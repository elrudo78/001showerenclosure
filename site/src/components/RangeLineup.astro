---
import { Image } from 'astro:assets'
import sliding from '../assets/catalog/s26132.png'
import neoAngle from '../assets/catalog/d15131.png'
import pivot from '../assets/catalog/s93021.png'
import lShape from '../assets/catalog/l99131.png'
import panoramic from '../assets/catalog/s890.png'

// Counts are the products in Dulifei's 2025 catalog, grouped by layout (docs/rebuild/PLAN.md).
const layouts = [
  { href: '/products/sliding-shower-doors/', name: 'Sliding doors', count: 15, img: sliding, alt: 'Line render of a three-panel sliding shower door with a black frame' },
  { href: '/products/neo-angle-shower-enclosures/', name: 'Neo-angle corners', count: 11, img: neoAngle, alt: 'Line render of a five-sided neo-angle corner shower enclosure with a pivot door' },
  { href: '/products/pivot-shower-doors/', name: 'Pivot and hinged doors', count: 4, img: pivot, alt: 'Line render of a straight shower screen with a hinged glass door and a fixed panel' },
  { href: '/products/l-and-t-shape-enclosures/', name: 'L and T shapes', count: 4, img: lShape, alt: 'Line render of an L-shaped shower enclosure with a pivot door' },
  { href: '/products/panoramic-sliding-systems/', name: 'Panoramic sliding', count: 2, img: panoramic, alt: 'Line render of a four-panel panoramic sliding door with a top track' },
]
---

<section class="section range" aria-labelledby="range-title">
  <div class="wrap">
    <div class="head">
      <h2 id="range-title">Choose a layout</h2>
      <p class="intro">
        Every model has a standard size and a range it can be made to, so one design can fit very different bathrooms.
      </p>
    </div>

    <ul class="lineup">
      {layouts.map((l) => (
        <li>
          <a href={l.href}>
            <span class="plinth">
              <Image src={l.img} alt={l.alt} widths={[240, 360, 520]} sizes="(min-width: 64rem) 18vw, (min-width: 40rem) 30vw, 45vw" class="render" />
            </span>
            <span class="label">
              <span class="name">{l.name}</span>
              <span class="count num">{l.count} models</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .head {
    display: grid;
    gap: var(--s-16);
    margin-bottom: var(--s-48);
  }

  .head .intro {
    margin: 0;
  }

  .lineup {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    row-gap: var(--s-48);
    margin: 0 calc(var(--s-8) * -1);
    padding: 0;
    list-style: none;
  }

  .lineup a {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }

  /* Columns touch, so the floor lines join into one line per row, like an elevation drawing. */
  .plinth {
    display: block;
    padding: 0 var(--s-8);
    border-bottom: 1px solid var(--ink);
  }

  .render {
    width: 100%;
    height: auto;
  }

  .label {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: var(--s-12) var(--s-8) 0;
  }

  .name {
    font-weight: 560;
    font-stretch: var(--wide);
    line-height: 1.3;
  }

  .count {
    color: var(--graphite);
    font-size: var(--t-14);
  }

  .lineup a:hover .name,
  .lineup a:focus-visible .name {
    color: var(--glass);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 40rem) {
    .lineup {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: end;
      gap: var(--s-64);
    }

    .lineup {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
