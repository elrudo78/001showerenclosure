---
import type { Specs } from '../data/catalog'

interface Props {
  specs: Specs
}
const { specs } = Astro.props
const rows = [
  ['Can be made as', specs.shapes?.join(', ')],
  ['Door', specs.door],
  ['Glass', specs.glass],
  ['Seal', specs.seal],
  ['Standard size', specs.standard],
  ['Made to measure', specs.custom],
  ['Frame finishes', specs.finishes.join(', ')],
  ['Handle', specs.handle],
].filter(([, v]) => v) as [string, string][]
---

<table class="specs num">
  <caption class="visually-hidden">Specifications</caption>
  <tbody>
    {rows.map(([k, v]) => (
      <tr>
        <th scope="row">{k}</th>
        <td>{v}</td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  .specs {
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid var(--ink);
  }

  th,
  td {
    overflow-wrap: anywhere;
  }

  td {
    padding: var(--s-12) 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  th {
    width: 38%;
    padding-right: var(--s-16);
    font-weight: 560;
  }

  td {
    color: var(--graphite);
  }
</style>
