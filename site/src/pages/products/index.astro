---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import Base from '../../layouts/Base.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import ProductGrid from '../../components/ProductGrid.astro'
import InquiryForm from '../../components/InquiryForm.astro'
import { layouts, layoutUrl, productsIn, products, type LayoutId } from '../../data/catalog'
import { breadcrumbLd } from '../../data/site'
import sliding from '../../assets/catalog/s26132.png'
import neoAngle from '../../assets/catalog/d15131.png'
import pivot from '../../assets/catalog/s93021.png'
import lShape from '../../assets/catalog/l99131.png'
import panoramic from '../../assets/catalog/s890.png'
import bathroomDoor from '../../assets/catalog/bathroomdoor.png'

// An overview, not the full list: four models per layout, then a link to the layout's own page
// (all its models and the comparison table).
const PREVIEW = 4
const drawing: Record<LayoutId, ImageMetadata> = {
  sliding,
  'neo-angle': neoAngle,
  pivot,
  'l-t': lShape,
  panoramic,
  'bathroom-door': bathroomDoor,
}
const groups = layouts.map((l) => {
  const all = productsIn(l.id)
  return { layout: l, all, shown: all.slice(0, PREVIEW), compare: all.filter((p) => p.specs).length > 1 }
})

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Products', href: '/products/' },
]
const jsonLd = [
  breadcrumbLd(crumbs, Astro.site),
  {
    '@type': 'CollectionPage',
    name: 'Shower enclosures and sliding doors',
    url: new URL('/products/', Astro.site).href,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: layouts.length,
      itemListElement: layouts.map((l, i) => ({ '@type': 'ListItem', position: i + 1, name: l.name, url: new URL(layoutUrl(l), Astro.site).href })),
    },
  },
]
const arrowDown = 'M12 5v14M6 13l6 6 6-6'
const arrowRight = 'M5 12h14M13 6l6 6-6 6'
---

<Base
  title="Shower enclosures and sliding doors, made to measure | Dulifei"
  description={`The full Dulifei range: ${products.length} sliding doors, neo-angle and L or T enclosures, pivot screens and panoramic systems, each with printed specifications and a made-to-measure size range.`}
  jsonLd={jsonLd}
>
  <Breadcrumbs items={crumbs} />
  <section class="wrap intro-block">
    <h1>Shower enclosures and sliding doors</h1>
    <p class="lead">
      {products.length} models in {layouts.length} layouts. Every model has a standard size and a range it can be made to.
      Open a layout to see all its models and compare their sizes.
    </p>

    <nav class="index" aria-labelledby="index-title">
      <p class="index-title" id="index-title">Jump to a layout</p>
      <ul>
        {groups.map(({ layout: l }) => (
          <li>
            <a href={`#${l.slug}`}>
              <Image src={drawing[l.id]} alt="" widths={[120, 180, 240]} sizes="(min-width: 64rem) 9rem, 28vw" class="i-pic" />
              <span class="i-name">
                {l.short}
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d={arrowDown} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  {
    groups.map(({ layout: l, all, shown, compare }) => (
      <section class="wrap group" id={l.slug} aria-labelledby={`h-${l.slug}`}>
        <div class="group-head">
          <h2 id={`h-${l.slug}`}>
            <a class="title-link" href={layoutUrl(l)}>
              {l.name}
              <svg class="go" width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><path d={arrowRight} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
          </h2>
          {all.length > 1 && (
            <a class="button quiet" href={layoutUrl(l)} aria-label={`See all ${l.name}${compare ? ' and compare them' : ''}`}>
              {compare ? 'See all and compare' : 'See all'}
            </a>
          )}
        </div>
        <ProductGrid products={shown} />
      </section>
    ))
  }

  <InquiryForm />
</Base>

<style>
  .intro-block {
    padding-block: var(--s-32) var(--s-64);
  }

  .intro-block h1 {
    max-width: 14em;
  }

  .intro-block .lead {
    margin-top: var(--s-24);
  }

  /* Index: one box per layout, with its drawing, so it reads as a set of buttons before any hover. */
  .index {
    margin-top: var(--s-64);
  }

  .index-title {
    margin-bottom: var(--s-16);
    color: var(--graphite);
    font-size: var(--t-14);
    font-weight: 560;
  }

  .index ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-12);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .index a {
    display: flex;
    flex-direction: column;
    height: 100%;
    margin: 0;
    padding: var(--s-12) var(--s-12) var(--s-16);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition:
      background-size 220ms cubic-bezier(0.3, 0.7, 0.2, 1),
      border-color 200ms ease,
      color 160ms ease;
  }

  .index a:hover {
    border-color: var(--ink);
  }

  .i-pic {
    width: 100%;
    max-width: 7rem;
    height: auto;
    aspect-ratio: 4 / 5;
    margin: 0 auto var(--s-12);
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .i-name {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-8);
    margin-top: auto;
    font-weight: 560;
    font-stretch: var(--wide);
    line-height: 1.25;
  }

  .i-name svg {
    flex: none;
    color: var(--glass);
    transition: translate 200ms ease;
  }

  .index a:hover .i-name svg {
    translate: 0 3px;
  }

  /* One block per layout: a large heading that links to the layout page, its button, four models. */
  .group {
    padding-bottom: var(--section);
    scroll-margin-top: calc(var(--header-space) + var(--s-16));
  }

  /* Divider above each layout, as wide as the content. */
  .group::before {
    content: '';
    display: block;
    height: 1px;
    margin-bottom: var(--section);
    background: var(--line);
  }

  .group-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-16) var(--s-32);
    margin-bottom: var(--s-32);
  }

  .group-head h2 {
    font-size: clamp(var(--t-26), 1.2rem + 1.9vw, 2.75rem);
  }

  .group-head h2 a {
    text-decoration: none;
  }

  .go {
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    margin-left: 0.15em;
    color: var(--glass);
    vertical-align: -0.02em;
    transition: translate 200ms ease;
  }

  .group-head h2 a:hover .go {
    translate: 4px 0;
  }

  /* Phones: compact rows, small drawing beside the name. */
  @media (max-width: 39.99rem) {
    .index ul {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-8);
    }

    .index a {
      flex-direction: row;
      align-items: center;
      gap: var(--s-8);
      padding: var(--s-8) var(--s-12) var(--s-8) var(--s-8);
    }

    .i-pic {
      max-width: 2.5rem;
      margin: 0;
    }

    .i-name {
      flex: 1;
      margin-top: 0;
      font-size: var(--t-14);
    }
  }

  @media (min-width: 40rem) {
    .index ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .index ul {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
</style>
