---
import { Picture } from 'astro:assets'
import glass from '../assets/factory/glass-edges.jpg'
import racks from '../assets/factory/profile-racks.jpg'
import packing from '../assets/factory/packing-line.jpg'

const photos = [
  { src: glass, alt: 'Glass panels stacked on edge, showing the green tint of the glass edges', caption: 'Glass panels, seen edge on' },
  { src: racks, alt: 'Yellow racks holding raw aluminium profiles in the material store', caption: 'Aluminium profiles in the material store' },
  { src: packing, alt: 'Packing line with a roller conveyor and a strapping machine', caption: 'Packing line' },
]
---

<section class="section factory" aria-labelledby="factory-title">
  <div class="wrap">
    <div class="head">
      <h2 id="factory-title">Made in our own factory</h2>
      <p class="intro">
        Aluminium profiles are stored, measured and drilled, and finished enclosures are packed for shipping at our
        factory in Zhongshan, Guangdong.
      </p>
      <a class="more" href="/factory/">Inside the factory</a>
    </div>

    <ul class="photos">
      {photos.map((p, i) => (
        <li class={`p${i + 1}`}>
          <figure>
            <Picture
              src={p.src}
              formats={['avif', 'webp']}
              widths={[480, 720, 1080, 1440]}
              sizes={i === 0 ? '(min-width: 64rem) 58vw, 100vw' : '(min-width: 64rem) 28vw, 100vw'}
              alt={p.alt}
              class="photo"
            />
            <figcaption>{p.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .head {
    display: grid;
    gap: var(--s-16);
    margin-bottom: var(--s-48);
  }

  .head .intro {
    margin: 0;
  }

  .more {
    justify-self: start;
    font-weight: 560;
  }

  .photos {
    display: grid;
    gap: var(--s-24);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  figure {
    margin: 0;
  }

  .photo {
    width: 100%;
    aspect-ratio: 3 / 2;
    height: auto;
    object-fit: cover;
  }

  figcaption {
    margin-top: var(--s-8);
    color: var(--graphite);
    font-size: var(--t-14);
  }

  @media (min-width: 40rem) {
    .photos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .p1 {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    .head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: auto auto;
      column-gap: var(--s-64);
    }

    .head h2 {
      grid-row: 1 / 3;
    }

    .photos {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--s-24);
      row-gap: var(--s-32);
    }

    .p1 {
      grid-column: 1 / 8;
      grid-row: 1 / 3;
    }

    .p1 .photo {
      aspect-ratio: auto;
      height: 100%;
    }

    .p1 figure {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .p1 :global(picture) {
      flex: 1;
      min-height: 0;
    }

    .p2 {
      grid-column: 8 / 13;
    }

    .p3 {
      grid-column: 8 / 13;
    }
  }
</style>
