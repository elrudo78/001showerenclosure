---
import { Picture } from 'astro:assets'
import pivotBlack from '../assets/projects/pivot-black-bathtub.jpg'
import neoGold from '../assets/projects/neo-angle-gold.jpg'
import cornerBlack from '../assets/projects/corner-black.jpg'
import slidingBronze from '../assets/projects/sliding-bronze.jpg'

// Real installations from the client's files (P0419, P0424, P0361, P0422). None from the Fuli folder.
// Captions say only what each photo shows.
const photos = [
  { src: pivotBlack, alt: 'Glass shower enclosure with a slim black frame and a pivot door beside a freestanding bathtub', caption: 'Pivot door, black frame' },
  { src: neoGold, alt: 'Neo-angle shower enclosure with a champagne gold frame against marble tiles', caption: 'Neo-angle enclosure, champagne gold' },
  { src: cornerBlack, alt: 'Corner glass shower enclosure with a thin black frame and a hinged door in a white bathroom', caption: 'Corner enclosure, black frame' },
  { src: slidingBronze, alt: 'Two-panel sliding shower door with a bronze-grey frame and towel bar handles', caption: 'Sliding door, bronze-grey frame' },
]
---

<section class="section projects" aria-labelledby="projects-title">
  <div class="wrap">
    <div class="head">
      <h2 id="projects-title">Installed in real bathrooms</h2>
      <a class="more" href="/projects/">More projects</a>
    </div>

    <ul class="photos">
      {photos.map((p) => (
        <li>
          <figure>
            <Picture
              src={p.src}
              formats={['avif', 'webp']}
              widths={[360, 540, 720, 960]}
              sizes="(min-width: 64rem) 24vw, 50vw"
              alt={p.alt}
              class="photo"
            />
            <figcaption>{p.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .projects {
    padding-top: 0;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-16);
    margin-bottom: var(--s-32);
  }

  .more {
    font-weight: 560;
  }

  .photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-24) var(--s-16);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  figure {
    margin: 0;
  }

  .photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  figcaption {
    margin-top: var(--s-8);
    color: var(--graphite);
    font-size: var(--t-14);
  }

  @media (min-width: 64rem) {
    .photos {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--s-24);
    }
  }
</style>
