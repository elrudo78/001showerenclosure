---
// What happens after a buyer sends an inquiry. Only steps that are true for any made-to-order enclosure:
// no lead times, sample terms or drawings, since none of these have been confirmed.
const steps = [
  { title: 'Send your sizes', text: 'The opening width and height, the layout and the frame finish. A photo of the space helps.' },
  { title: 'Get a quote', text: 'Our sales team matches your sizes to a model and replies by email, or on WhatsApp if you leave a number.' },
  { title: 'Confirm the details', text: 'Sizes, glass, finish, handle and quantity are agreed before anything is made.' },
  { title: 'Made to size and packed', text: 'Each enclosure is made to the agreed sizes, then packed for shipping.' },
]
---

<section class="section how" aria-labelledby="how-title">
  <div class="wrap">
    <h2 id="how-title">How an order works</h2>
    <ol class="steps">
      {steps.map((s, i) => (
        <li>
          <span class="n num" aria-hidden="true">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-32);
    margin: var(--s-48) 0 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-8);
    padding-top: var(--s-16);
    border-top: 1px solid var(--ink);
  }

  .n {
    color: var(--glass);
    font-size: var(--t-33);
    font-stretch: var(--wide);
    font-weight: 600;
    line-height: 1;
  }

  h3 {
    margin-top: var(--s-8);
    font-size: var(--t-17);
  }

  p {
    color: var(--graphite);
  }

  @media (min-width: 40rem) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
