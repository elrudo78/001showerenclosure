---
import Base from '../layouts/Base.astro'
import Hero from '../components/Hero.astro'
import RangeLineup from '../components/RangeLineup.astro'
import Specify from '../components/Specify.astro'
import FactoryStrip from '../components/FactoryStrip.astro'
import ProjectsStrip from '../components/ProjectsStrip.astro'
import InquiryForm from '../components/InquiryForm.astro'
import HowItWorks from '../components/HowItWorks.astro'

const jsonLd = {
  '@type': 'WebSite',
  name: 'Dulifei Shower Enclosures',
  url: new URL('/', Astro.site).href,
  publisher: { '@id': new URL('/#organization', Astro.site).href },
}
---

<Base
  title="Made-to-measure shower enclosures from Zhongshan, China | Dulifei"
  description="Dulifei makes glass shower enclosures and sliding doors to your sizes: sliding, neo-angle, pivot, L and T shapes, in matte black, gold, silver and chrome frames."
  jsonLd={jsonLd}
>
  <Hero />
  <RangeLineup />
  <Specify />
  <FactoryStrip />
  <ProjectsStrip />
  <HowItWorks />
  <InquiryForm />
</Base>
