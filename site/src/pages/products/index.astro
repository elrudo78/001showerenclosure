---
import Base from '../../layouts/Base.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import ProductGrid from '../../components/ProductGrid.astro'
import InquiryForm from '../../components/InquiryForm.astro'
import { layouts, layoutUrl, productsIn, products, productUrl } from '../../data/catalog'
import { breadcrumbLd } from '../../data/site'

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Products', href: '/products/' },
]
// Highlight the pill for the layout being shown (the section in the address, e.g. #sliding-shower-doors), or "All".
const activePill = `${layouts.map((l) => `.catalog:has(#${l.slug}:target) .filters a[href="#${l.slug}"]`).join(',')},.catalog:not(:has(.group:target)) .filters a[href="#all"]{background:var(--ink);border-color:var(--ink);color:var(--white)}`
const jsonLd = [
  breadcrumbLd(crumbs, Astro.site),
  {
    '@type': 'CollectionPage',
    name: 'Shower enclosures and sliding doors',
    url: new URL('/products/', Astro.site).href,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: products.length,
      itemListElement: products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.name, url: new URL(productUrl(p), Astro.site).href })),
    },
  },
]
---

<Base
  title="Shower enclosures and sliding doors, made to measure | Dulifei"
  description={`The full Dulifei range: ${products.length} sliding doors, neo-angle and L or T enclosures, pivot screens and panoramic systems, each with printed specifications and a made-to-measure size range.`}
  jsonLd={jsonLd}
>
  <Breadcrumbs items={crumbs} />
  <section class="wrap intro-block">
    <h1>Shower enclosures and sliding doors</h1>
    <p class="lead">
      {products.length} models, grouped by layout. Every model has a standard size and a range it can be made to, so
      send us your measurements with the model you like.
    </p>
  </section>

  <div class="catalog" id="all">
    <Fragment set:html={`<style>${activePill}</style>`} />
    <nav class="filters" aria-label="Show one layout">
      <ul class="wrap">
        <li><a href="#all">All <span class="num">{products.length}</span></a></li>
        {layouts.map((l) => (
          <li>
            <a href={`#${l.slug}`}>{l.short} <span class="num">{productsIn(l.id).length}</span></a>
          </li>
        ))}
      </ul>
    </nav>

    {
      layouts.map((l) => (
        <section class="wrap group" id={l.slug} aria-labelledby={`h-${l.slug}`}>
          <div class="group-head">
            <h2 id={`h-${l.slug}`}>
              <a href={layoutUrl(l)}>{l.name}</a>
            </h2>
            <p class="intro">{l.intro}</p>
          </div>
          <ProductGrid products={productsIn(l.id)} />
        </section>
      ))
    }
  </div>

  <InquiryForm />
</Base>

<style>
  .intro-block {
    padding-block: var(--s-32) var(--s-48);
  }

  .intro-block .lead {
    margin-top: var(--s-24);
  }

  /* Layout filter: pills that stay under the header while scrolling. A pill links to its section;
     while a section is in the address (:target), only that section shows. */
  .filters {
    position: sticky;
    top: var(--header-space);
    z-index: 10;
    background: var(--white);
    box-shadow: 0 1px 0 var(--line);
    transition: top 280ms cubic-bezier(0.3, 0.7, 0.2, 1);
  }

  .filters ul {
    display: flex;
    gap: var(--s-8);
    margin: 0 auto;
    padding-block: var(--s-12);
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .filters li {
    flex: none;
  }

  .filters a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-8);
    padding: var(--s-8) var(--s-16);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-weight: 560;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease;
  }

  .filters a:hover {
    background: var(--pill);
    border-color: var(--pill-current);
    color: var(--ink);
  }

  .filters .num {
    font-size: var(--t-14);
    font-weight: 400;
    opacity: 0.75;
  }

  .catalog:has(.group:target) .group:not(:target) {
    display: none;
  }

  .group {
    padding-block: var(--s-48) var(--section);
    scroll-margin-top: calc(var(--header-space) + 4rem);
  }

  .group-head {
    display: grid;
    gap: var(--s-16);
    margin-bottom: var(--s-48);
  }

  .group-head .intro {
    margin: 0;
  }

  .group-head h2 a {
    text-decoration: none;
  }

  .group-head h2 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  @media (min-width: 64rem) {
    .group-head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: end;
      gap: var(--s-64);
    }
  }
</style>
