---
// The same scene in several frame finishes. Radio buttons switch the picture without any JavaScript.
import { Picture } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  name: string
  items: { finish: string; src: ImageMetadata }[]
}
const { name, items } = Astro.props
const slug = (s: string) => s.toLowerCase().replace(/[^a-z]+/g, '-')
---

<figure class="gallery">
  <div class="stage" style={`aspect-ratio:${items[0].src.width} / ${items[0].src.height}`}>
    {items.map((it, i) => (
      <Picture
        src={it.src}
        formats={['avif', 'webp']}
        widths={[480, 760, 1080, 1520]}
        sizes="(min-width: 64rem) 58vw, 100vw"
        alt={`${name} with a ${it.finish.toLowerCase()} frame`}
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : undefined}
        class="shot"
        pictureAttributes={{ class: `pic pic-${slug(it.finish)}`, 'data-index': String(i) }}
      />
    ))}
  </div>
  <figcaption>
    <fieldset>
      <legend>Frame finish</legend>
      <div class="swatches">
        {items.map((it, i) => (
          <label class={`swatch swatch-${slug(it.finish)}`}>
            <input type="radio" name="gallery-finish" value={slug(it.finish)} checked={i === 0} />
            <span class="chip" aria-hidden="true" />
            <span class="label">{it.finish}</span>
          </label>
        ))}
      </div>
    </fieldset>
  </figcaption>
</figure>

<style>
  .gallery {
    margin: 0;
  }

  .stage {
    position: relative;
    overflow: hidden;
    background: var(--stone);
  }

  .stage :global(.pic),
  .stage :global(.shot) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .stage :global(.shot) {
    object-fit: cover;
  }

  .stage :global(.pic) {
    opacity: 0;
    transition: opacity 420ms ease;
  }

  .stage :global(.pic[data-index='0']) {
    opacity: 1;
  }

  .gallery:has(input[value='brushed-gold']:checked) :global(.pic-brushed-gold),
  .gallery:has(input[value='brushed-silver']:checked) :global(.pic-brushed-silver),
  .gallery:has(input[value='polished-chrome']:checked) :global(.pic-polished-chrome),
  .gallery:has(input[value='matte-black']:checked) :global(.pic-matte-black) {
    opacity: 1;
  }

  .gallery:has(input:not([value='matte-black']):checked) :global(.pic-matte-black) {
    opacity: 0;
  }

  fieldset {
    margin: var(--s-16) 0 0;
    padding: 0;
    border: 0;
  }

  legend {
    padding: 0;
    margin-bottom: var(--s-8);
    color: var(--graphite);
    font-size: var(--t-14);
  }

  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4) var(--s-16);
  }

  .swatch {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--s-8);
    min-height: 2.75rem;
    cursor: pointer;
  }

  .swatch input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .chip {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.18);
    outline: 1px solid transparent;
    outline-offset: 3px;
  }

  .swatch-matte-black .chip {
    background: linear-gradient(135deg, #3a3c3f, #17181a);
  }

  .swatch-brushed-gold .chip {
    background: linear-gradient(135deg, #e3c88f, #b08a4f 55%, #d9bd84);
  }

  .swatch-brushed-silver .chip {
    background: linear-gradient(135deg, #e4e6e7, #a9adb0 55%, #d5d8da);
  }

  .swatch-polished-chrome .chip {
    background: linear-gradient(135deg, #ffffff, #9aa3a9 45%, #f2f4f5 60%, #7f878c);
  }

  .label {
    color: var(--graphite);
    font-size: var(--t-14);
  }

  .swatch input:checked ~ .chip {
    outline-color: var(--ink);
  }

  .swatch input:checked ~ .label {
    color: var(--ink);
    font-weight: 560;
  }

  .swatch input:focus-visible ~ .chip {
    outline: 2px solid var(--glass);
  }
</style>
