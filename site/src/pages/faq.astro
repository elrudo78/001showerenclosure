---
import Base from '../layouts/Base.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import { breadcrumbLd } from '../data/site'
import { faq } from '../data/faq'

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'FAQ', href: '/faq/' },
]
const jsonLd = [
  breadcrumbLd(crumbs, Astro.site),
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
]
---

<Base
  title="Questions about made-to-measure shower enclosures | Dulifei"
  description="Answers to the questions buyers ask Dulifei about made-to-measure shower enclosures: sizes, glass, frame finishes, seals and how to send an inquiry."
  jsonLd={jsonLd}
>
  <Breadcrumbs items={crumbs} />
  <section class="wrap faq" aria-labelledby="faq-title">
    <h1 id="faq-title">Questions buyers ask</h1>
    <p class="lead">Short answers about sizes, glass, finishes and ordering. If your question is not here, <a href="/contact/">ask our sales team</a>.</p>
    <div class="list">
      {faq.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
    <p class="next">
      <a class="button" href="/contact/">Request a quote</a>
    </p>
  </section>
</Base>

<style>
  .faq {
    padding-block: var(--s-32) var(--section);
  }

  .lead {
    margin-top: var(--s-24);
  }

  .list {
    margin-top: var(--s-48);
    border-top: 1px solid var(--ink);
    max-width: 52rem;
  }

  details {
    border-bottom: 1px solid var(--line);
  }

  summary {
    display: flex;
    justify-content: space-between;
    gap: var(--s-16);
    padding: var(--s-16) 0;
    font-weight: 560;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    color: var(--glass);
    font-size: var(--t-21);
    line-height: 1;
  }

  details[open] summary::after {
    content: '−';
  }

  details p {
    padding-bottom: var(--s-16);
    color: var(--graphite);
    max-width: 40em;
  }

  .next {
    margin-top: var(--s-48);
  }
</style>
