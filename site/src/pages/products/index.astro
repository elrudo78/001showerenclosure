---
import Base from '../../layouts/Base.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import ProductGrid from '../../components/ProductGrid.astro'
import InquiryForm from '../../components/InquiryForm.astro'
import { layouts, layoutUrl, productsIn, products } from '../../data/catalog'
import { breadcrumbLd } from '../../data/site'

// An overview, not the full list: four models per layout, then a link to the layout's own page
// (all its models and the comparison table).
const PREVIEW = 4
const groups = layouts.map((l) => {
  const all = productsIn(l.id)
  return { layout: l, all, shown: all.slice(0, PREVIEW), compare: all.filter((p) => p.specs).length > 1 }
})

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Products', href: '/products/' },
]
const jsonLd = [
  breadcrumbLd(crumbs, Astro.site),
  {
    '@type': 'CollectionPage',
    name: 'Shower enclosures and sliding doors',
    url: new URL('/products/', Astro.site).href,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: layouts.length,
      itemListElement: layouts.map((l, i) => ({ '@type': 'ListItem', position: i + 1, name: l.name, url: new URL(layoutUrl(l), Astro.site).href })),
    },
  },
]
---

<Base
  title="Shower enclosures and sliding doors, made to measure | Dulifei"
  description={`The full Dulifei range: ${products.length} sliding doors, neo-angle and L or T enclosures, pivot screens and panoramic systems, each with printed specifications and a made-to-measure size range.`}
  jsonLd={jsonLd}
>
  <Breadcrumbs items={crumbs} />
  <section class="wrap intro-block">
    <div class="intro-text">
      <h1>Shower enclosures and sliding doors</h1>
      <p class="lead">
        {products.length} models in {layouts.length} layouts. Every model has a standard size and a range it can be made
        to. Open a layout to see all its models and compare their sizes.
      </p>
    </div>

    <nav class="index" aria-label="Layouts">
      <ol>
        {groups.map(({ layout: l, all }) => (
          <li>
            <a href={`#${l.slug}`}>
              <span class="i-name">{l.short}</span>
              <span class="i-tag">{l.tagline}</span>
              <span class="i-count num">{all.length === 1 ? '1 model' : `${all.length} models`}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </section>

  {
    groups.map(({ layout: l, all, shown, compare }) => (
      <section class="wrap group" id={l.slug} aria-labelledby={`h-${l.slug}`}>
        <div class="group-head">
          <h2 id={`h-${l.slug}`}>
            <a href={layoutUrl(l)}>{l.name}</a>
          </h2>
          <p class="intro">{l.intro}</p>
        </div>
        <ProductGrid products={shown} />
        {all.length > PREVIEW ? (
          <p class="more">
            <a class="button" href={layoutUrl(l)} aria-label={`See all ${all.length} ${l.name}`}>
              See all {all.length} models
            </a>
          </p>
        ) : (
          compare && (
            <p class="more">
              <a class="button" href={`${layoutUrl(l)}#compare`} aria-label={`Compare the ${all.length} ${l.name}`}>
                Compare the {all.length} models
              </a>
            </p>
          )
        )}
      </section>
    ))
  }

  <InquiryForm />
</Base>

<style>
  .intro-block {
    display: grid;
    gap: var(--s-48);
    padding-block: var(--s-32) var(--s-48);
  }

  .intro-block .lead {
    margin-top: var(--s-24);
  }

  /* Index of layouts: one row each, with the name, a few words and how many models. */
  .index ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .index li {
    border-bottom: 1px solid var(--line);
  }

  .index a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-4) var(--s-16);
    padding: var(--s-12) var(--s-8);
    margin-inline: calc(var(--s-8) * -1);
    text-decoration: none;
  }

  .i-name {
    font-weight: 560;
    font-stretch: var(--wide);
  }

  .i-tag {
    grid-column: 1;
    color: var(--graphite);
    font-size: var(--t-14);
  }

  .i-count {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    color: var(--graphite);
    font-size: var(--t-14);
  }

  .group {
    padding-block: var(--s-48) var(--section);
    scroll-margin-top: calc(var(--header-space) + var(--s-16));
  }

  .group-head {
    display: grid;
    gap: var(--s-16);
    margin-bottom: var(--s-48);
  }

  .group-head .intro {
    margin: 0;
  }

  .group-head h2 a {
    text-decoration: none;
  }

  .more {
    margin-top: var(--s-32);
  }

  @media (min-width: 48rem) {
    .index a {
      grid-template-columns: 14rem minmax(0, 1fr) auto;
      align-items: baseline;
    }

    .i-tag {
      grid-column: 2;
    }

    .i-count {
      grid-column: 3;
      grid-row: auto;
    }
  }

  @media (min-width: 64rem) {
    .intro-block {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
      gap: var(--s-64);
    }

    .group-head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: end;
      gap: var(--s-64);
    }
  }
</style>
