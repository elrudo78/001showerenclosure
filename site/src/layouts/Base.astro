---
import '../styles/global.css'
import archivo from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import defaultShare from '../assets/hero/finish-black.jpg'
import { organizationLd } from '../data/site'

interface Props {
  title: string
  description: string
  jsonLd?: object | object[]
  image?: ImageMetadata
  imageAlt?: string
  noindex?: boolean
}

const { title, description, jsonLd, image = defaultShare, imageAlt = 'DLFC05 sliding shower enclosure with a matte black frame', noindex = false } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site).href
const share = await getImage({ src: image, width: 1200, format: 'jpg' })
const shareUrl = new URL(share.src, Astro.site).href
// Every page carries the Organization; pages add their own items (Product, BreadcrumbList, FAQPage...).
const graph = { '@context': 'https://schema.org', '@graph': [organizationLd(Astro.site), ...(jsonLd ? [jsonLd].flat() : [])] }
// Optional services, switched on at build time (see site/DEPLOY.md).
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION
const speculation = {
  prerender: [{ where: { and: [{ href_matches: '/*' }, { not: { href_matches: '/api/*' } }] }, eagerness: 'moderate' }],
}
const fontFace =`@font-face{font-family:'Archivo';font-style:normal;font-display:swap;font-weight:100 900;font-stretch:62% 125%;src:url(${archivo}) format('woff2-variations'),url(${archivo}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFace} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f5f6f1" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dulifei Shower Enclosures" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Site summary for AI tools" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <!-- Chrome and Edge get the next page ready while the pointer rests on a link, so pictures are loaded before the page change. -->
    <script type="speculationrules" is:inline set:html={JSON.stringify(speculation)} />
    <!-- Product picture moves between pages. If the new page's picture has not loaded yet, the picture that was
         clicked makes the move on its own, waits in place until the real one has loaded (at most 1.5 s), then
         cross-fades to it. So the movement always happens and never shows an empty box. -->
    <script is:inline>
      addEventListener('pagereveal', function (e) {
        var vt = e.viewTransition
        if (!vt) return
        var root = document.documentElement
        // The moving picture: on a product page its own; on a list page, the product we came back from.
        var el = document.querySelector('.studio, .gallery .stage')
        var from = window.navigation && navigation.activation && navigation.activation.from
        if (!el && from) {
          var slug = new URL(from.url).pathname.split('/').filter(Boolean).pop()
          el = [].find.call(document.querySelectorAll('[style*="view-transition-name"]'), function (x) {
            return x.style.viewTransitionName === 'product-' + slug
          })
        }
        var img = el && el.querySelector('img')
        if (!img || (img.complete && img.naturalWidth)) return
        var name = el.style.viewTransitionName || getComputedStyle(el).viewTransitionName
        root.classList.add('vt-hold-old')
        vt.finished.finally(function () { root.classList.remove('vt-hold-old') })
        vt.ready.then(function () {
          var pe = function (part) { return '::view-transition-' + part + '(' + name + ')' }
          var keep = root.animate([{}, {}], { duration: 1500, pseudoElement: pe('group') })
          var done = false
          var reveal = function () {
            if (done) return
            done = true
            root.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 260, easing: 'ease', fill: 'forwards', pseudoElement: pe('new') })
              .finished.then(function () { keep.cancel() })
          }
          if (img.complete) reveal()
          img.addEventListener('load', reveal, { once: true })
          img.addEventListener('error', function () { keep.cancel() }, { once: true })
        })
      })
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {
      analyticsToken && (
        <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: analyticsToken })} />
      )
    }
  </body>
</html>
