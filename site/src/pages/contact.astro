---
import Base from '../layouts/Base.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import InquiryForm from '../components/InquiryForm.astro'
import HowItWorks from '../components/HowItWorks.astro'
import ContactDetails from '../components/ContactDetails.astro'
import { breadcrumbLd } from '../data/site'

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Contact', href: '/contact/' },
]
const jsonLd = [breadcrumbLd(crumbs, Astro.site)]
---

<Base
  title="Request a quote for made-to-measure shower enclosures | Dulifei"
  description="Send your sizes, layout and frame finish to Dulifei's sales team for a quote on glass shower enclosures and sliding doors."
  jsonLd={jsonLd}
>
  <Breadcrumbs items={crumbs} />
  <section class="wrap top">
    <h1>Request a quote</h1>
    <p class="lead">Tell us what you need and our sales team will reply by email, or on WhatsApp if you leave a number.</p>
    <ul class="send num">
      <li>The opening: width and height in mm</li>
      <li>The layout, or a model code from our range</li>
      <li>The frame finish and glass you have in mind</li>
      <li>How many enclosures, and the country they are for</li>
    </ul>
    <p class="faq-link">Questions first? See the <a href="/faq/">answers to common questions</a>.</p>
  </section>

  <ContactDetails />
  <HowItWorks />
  <InquiryForm title="Your inquiry" />

</Base>

<style>
  .top {
    padding-block: var(--s-32) var(--s-64);
  }

  .top .lead {
    margin-top: var(--s-24);
  }

  .send {
    display: grid;
    gap: var(--s-8);
    margin: var(--s-24) 0 0;
    padding-left: 1.2em;
    color: var(--graphite);
    max-width: 36em;
  }

  .faq-link {
    margin-top: var(--s-24);
    color: var(--graphite);
  }
</style>
