{
  "name": "dulifei-site",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:site": "node scripts/check-built-site.mjs",
    "test": "node --test worker/*.test.js",
    "worker:dev": "astro build && wrangler d1 migrations apply dulifei-inquiries --local && wrangler dev",
    "deploy": "astro build && wrangler d1 migrations apply dulifei-inquiries --remote && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.2.8",
    "astro": "7.3.5",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "disposable-email-domains-js": "1.26.0",
    "wrangler": "4.149.0"
  }
}
