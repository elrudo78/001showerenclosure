---
import { Picture } from 'astro:assets'
import black from '../assets/hero/finish-black.jpg'
import gold from '../assets/hero/finish-gold.jpg'
import silver from '../assets/hero/finish-silver.jpg'
import chrome from '../assets/hero/finish-chrome.jpg'

// Same render in four frame finishes (client files P0139, P0136, P0137, P0138).
const finishes = [
  { id: 'black', label: 'Matte black', src: black },
  { id: 'gold', label: 'Brushed gold', src: gold },
  { id: 'silver', label: 'Brushed silver', src: silver },
  { id: 'chrome', label: 'Polished chrome', src: chrome },
]
const sizes = '(min-width: 82.5rem) 760px, (min-width: 56rem) 56vw, 100vw'
const widths = [480, 760, 1080, 1520]

// Enclosure frame inside the 2343 x 2100 image, in image pixels.
const frame = { left: 203, right: 1366, top: 336, bottom: 1814 }
const W = 2343
const H = 2100
const widthY = 236
const heightX = 112
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap grid">
    <div class="copy">
      <h1 id="hero-title">Shower enclosures made to your measurements</h1>
      <p class="lead">
        Dulifei designs and builds glass shower enclosures and sliding doors in Zhongshan, China. Tell us the width,
        height, layout and frame finish, and we make the enclosure to fit.
      </p>
      <div class="actions">
        <a class="button" href="#inquiry">Request a quote</a>
        <a class="button quiet" href="/products/">See the range</a>
      </div>
    </div>

    <figure class="stage">
      <div class="frame">
        {finishes.map((f, i) => (
          <Picture
            src={f.src}
            formats={['avif', 'webp']}
            widths={widths}
            sizes={sizes}
            alt={`Sliding glass shower enclosure with a ${f.label.toLowerCase()} frame in a white bathroom`}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            class={`shot shot-${f.id}`}
            pictureAttributes={{ class: `pic pic-${f.id}` }}
          />
        ))}

        <svg class="dims" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
          <g class="ext">
            <path d={`M${frame.left} ${frame.top - 40} V${widthY - 34}`} pathLength="1" />
            <path d={`M${frame.right} ${frame.top - 40} V${widthY - 34}`} pathLength="1" />
            <path d={`M${frame.left - 20} ${frame.top} H${heightX - 34}`} pathLength="1" />
            <path d={`M${frame.left - 20} ${frame.bottom} H${heightX - 34}`} pathLength="1" />
          </g>
          <g class="dim">
            <path d={`M${frame.left} ${widthY} H${frame.right}`} pathLength="1" />
            <path d={`M${heightX} ${frame.top} V${frame.bottom}`} pathLength="1" />
          </g>
          <g class="ticks">
            <path d={`M${frame.left - 18} ${widthY + 18} l36 -36 M${frame.right - 18} ${widthY + 18} l36 -36`} />
            <path d={`M${heightX - 18} ${frame.top + 18} l36 -36 M${heightX - 18} ${frame.bottom + 18} l36 -36`} />
          </g>
        </svg>
        <span class="dim-label width" style={`left:${pct((frame.left + frame.right) / 2, W)};top:${pct(widthY, H)}`}>Your width</span>
        <span class="dim-label height" style={`left:${pct(heightX, W)};top:${pct((frame.top + frame.bottom) / 2, H)}`}>Your height</span>
      </div>

      <figcaption class="finishes">
        <fieldset>
          <legend>Frame finish</legend>
          <div class="swatches">
            {finishes.map((f, i) => (
              <label class={`swatch swatch-${f.id}`}>
                <input type="radio" name="finish" value={f.id} checked={i === 0} />
                <span class="chip" aria-hidden="true" />
                <span class="name">{f.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-top: var(--s-32);
  }

  .grid {
    display: grid;
    gap: var(--s-32);
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: var(--s-24);
  }

  h1 {
    max-width: 11em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-12);
    margin-top: var(--s-8);
  }

  .stage {
    margin: 0;
  }

  .frame {
    position: relative;
    aspect-ratio: 2343 / 2100;
    background: var(--stone);
    overflow: hidden;
  }

  .pic,
  .shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .shot {
    object-fit: cover;
  }

  .pic {
    opacity: 0;
    transition: opacity 420ms ease;
  }

  .pic-black {
    opacity: 1;
  }

  .stage:has(input[value='gold']:checked) .pic-gold,
  .stage:has(input[value='silver']:checked) .pic-silver,
  .stage:has(input[value='chrome']:checked) .pic-chrome {
    opacity: 1;
  }

  .stage:has(input:not([value='black']):checked) .pic-black {
    opacity: 0;
  }

  /* Dimension lines: drawn once on load. */
  .dims {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--glass);
  }

  .dims path {
    vector-effect: non-scaling-stroke;
    stroke-width: 1.5;
  }

  .ext path {
    stroke-width: 1;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 500ms ease-out 200ms forwards;
  }

  .dim path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 900ms cubic-bezier(0.4, 0, 0.2, 1) 500ms forwards;
  }

  .ticks {
    opacity: 0;
    animation: show 300ms ease 1300ms forwards;
  }

  .dim-label {
    position: absolute;
    padding: 0 var(--s-8);
    background: var(--white);
    color: var(--glass);
    font-size: var(--t-14);
    font-weight: 560;
    line-height: 1.6;
    white-space: nowrap;
    opacity: 0;
    animation: show 400ms ease 1300ms forwards;
  }

  .dim-label.width {
    transform: translate(-50%, -50%);
  }

  .dim-label.height {
    transform: translate(-50%, -50%) rotate(-90deg);
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes show {
    to {
      opacity: 1;
    }
  }

  .finishes {
    margin-top: var(--s-16);
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    padding: 0;
    margin-bottom: var(--s-8);
    color: var(--graphite);
    font-size: var(--t-14);
  }

  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4) var(--s-16);
  }

  .swatch {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--s-8);
    min-height: 2.75rem;
    padding-right: var(--s-4);
    cursor: pointer;
  }

  .swatch input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .chip {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.18);
    outline: 1px solid transparent;
    outline-offset: 3px;
    transition: outline-color 160ms ease;
  }

  .swatch-black .chip {
    background: linear-gradient(135deg, #3a3c3f, #17181a);
  }

  .swatch-gold .chip {
    background: linear-gradient(135deg, #e3c88f, #b08a4f 55%, #d9bd84);
  }

  .swatch-silver .chip {
    background: linear-gradient(135deg, #e4e6e7, #a9adb0 55%, #d5d8da);
  }

  .swatch-chrome .chip {
    background: linear-gradient(135deg, #ffffff, #9aa3a9 45%, #f2f4f5 60%, #7f878c);
  }

  .name {
    color: var(--graphite);
    font-size: var(--t-14);
  }

  .swatch input:checked ~ .chip {
    outline-color: var(--ink);
  }

  .swatch input:checked ~ .name {
    color: var(--ink);
    font-weight: 560;
  }

  .swatch input:focus-visible ~ .chip {
    outline: 2px solid var(--glass);
  }

  @media (min-width: 56rem) {
    .hero {
      padding-top: var(--s-48);
    }

    .grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
      gap: var(--s-64);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ext path,
    .dim path {
      stroke-dashoffset: 0;
      animation: none;
    }

    .ticks,
    .dim-label {
      opacity: 1;
      animation: none;
    }
  }
</style>
