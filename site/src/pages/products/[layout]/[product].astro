---
import { Image, Picture } from 'astro:assets'
import Base from '../../../layouts/Base.astro'
import Breadcrumbs from '../../../components/Breadcrumbs.astro'
import ProductGrid from '../../../components/ProductGrid.astro'
import SpecTable from '../../../components/SpecTable.astro'
import FinishGallery from '../../../components/FinishGallery.astro'
import InquiryForm from '../../../components/InquiryForm.astro'
import { formLayout, layoutById, layoutUrl, products, productsIn, productUrl, summary, type Product } from '../../../data/catalog'
import { breadcrumbLd, company } from '../../../data/site'

export function getStaticPaths() {
  return products.map((product) => ({ params: { layout: layoutById(product.layout).slug, product: product.slug }, props: { product } }))
}

const { product } = Astro.props as { product: Product }
const layout = layoutById(product.layout)
const s = product.specs
const text = summary(product)
const others = productsIn(product.layout).filter((p) => p.slug !== product.slug)
// The next models after this one, wrapping round to the start; each shown once.
const start = Math.max(0, others.findIndex((p) => p.slug > product.slug))
const related = [...others.slice(start), ...others.slice(0, start)].slice(0, 4)
const url = new URL(productUrl(product), Astro.site).href
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Products', href: '/products/' },
  { name: layout.name, href: layoutUrl(layout) },
  { name: product.code, href: productUrl(product) },
]
const props = s
  ? [
      ['Can be made as', s.shapes?.join(', ')],
      ['Door', s.door],
      ['Glass', s.glass],
      ['Seal', s.seal],
      ['Standard size', s.standard],
      ['Made to measure', s.custom],
      ['Frame finishes', s.finishes.join(', ')],
      ['Handle', s.handle],
    ].filter(([, v]) => v)
  : [['Frame finishes', product.finishGallery!.map((f) => f.finish).join(', ')]]
const jsonLd = [
  breadcrumbLd(crumbs, Astro.site),
  {
    '@type': 'Product',
    '@id': `${url}#product`,
    name: product.name,
    sku: product.code,
    model: product.code,
    category: layout.name,
    description: text,
    url,
    brand: { '@type': 'Brand', name: company.brand },
    manufacturer: { '@id': new URL('/#organization', Astro.site).href },
    additionalProperty: props.map(([name, value]) => ({ '@type': 'PropertyValue', name, value })),
  },
]
const title = `${product.name}${s ? `, ${s.standard.replace(/ mm$/, ' mm')}` : ''} | Dulifei`
const description = `${text}`.slice(0, 300)
---

<Base title={title} description={description} jsonLd={jsonLd} image={product.finishGallery?.[0].src ?? product.photos?.[0].src ?? product.image} imageAlt={product.name}>
  <Breadcrumbs items={crumbs} />

  <article class="wrap product">
    <div class="media">
      {
        product.finishGallery ? (
          <FinishGallery name={product.name} items={product.finishGallery} hardware={product.hardware} transitionName={`product-${product.slug}`} />
        ) : (
          <div class:list={['studio', { photo: product.imageIsPhoto }]} style={`view-transition-name:product-${product.slug}`}>
            <Image
              src={product.image}
              alt={`${product.name}: ${product.kind}`}
              widths={[360, 540, 720, 960]}
              sizes="(min-width: 64rem) 40vw, 100vw"
              loading="eager"
              fetchpriority="high"
              class="studio-img"
            />
          </div>
        )
      }
    </div>

    <div class="info">
      <p class="layout-link"><a href={layoutUrl(layout)}>{layout.name}</a></p>
      <h1>{product.name}</h1>
      <p class="lead">{text}</p>
      <p class="actions">
        <a class="button" href="#inquiry">Request a quote for {product.code}</a>
      </p>
      {
        s ? (
          <section aria-labelledby="specs-title" class="spec-block">
            <h2 id="specs-title">Specifications</h2>
            <SpecTable specs={s} />
            <p class="note">Need a size outside these ranges? <a href="#inquiry">Ask us</a>.</p>
          </section>
        ) : (
          <section aria-labelledby="specs-title" class="spec-block">
            <h2 id="specs-title">Sizes and specifications</h2>
            <p class="intro">
              Made to order for each project. Send the opening width and height and the finish you want, and our sales
              team will reply with a quote.
            </p>
          </section>
        )
      }
    </div>
  </article>

  {
    product.photos && (
      <section class="wrap photos" aria-labelledby="photos-title">
        <h2 id="photos-title">In a room</h2>
        <ul>
          {product.photos.map((ph) => (
            <li style={`max-width:${ph.src.width}px`}>
              <Picture src={ph.src} formats={['avif', 'webp']} widths={[480, 760, 1080, 1520]} sizes="(min-width: 64rem) 66vw, 100vw" alt={ph.alt} class="photo-img" />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="wrap related" aria-labelledby="related-title">
        <div class="related-head">
          <h2 id="related-title">More {layout.name.toLowerCase()}</h2>
          <a href={layoutUrl(layout)}>See all</a>
        </div>
        <ProductGrid products={related} />
      </section>
    )
  }

  <InquiryForm product={product.name} layout={formLayout[product.layout]} title={`Ask about ${product.code}`} />
</Base>

<style>
  .product {
    display: grid;
    gap: var(--s-32);
    padding-block: var(--s-24) var(--section);
  }

  .studio {
    aspect-ratio: 4 / 5;
    max-height: 80vh;
    margin-inline: auto;
    border-bottom: 1px solid var(--ink);
    background: var(--white); /* keeps the blended drawing correct while it moves between pages */
    view-transition-class: product-pic;
  }

  .studio-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .studio.photo .studio-img {
    object-fit: cover;
    mix-blend-mode: normal;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: var(--s-24);
  }

  .layout-link {
    font-size: var(--t-14);
    color: var(--graphite);
  }

  .info h1 {
    font-size: clamp(2rem, 1.4rem + 2.4vw, var(--t-52));
  }

  .spec-block {
    margin-top: var(--s-16);
  }

  .spec-block h2 {
    font-size: var(--t-21);
    margin-bottom: var(--s-16);
  }

  .note {
    margin-top: var(--s-12);
    color: var(--graphite);
    font-size: var(--t-14);
  }

  .photos {
    padding-bottom: var(--section);
  }

  .photos ul {
    display: grid;
    gap: var(--s-24);
    margin: var(--s-32) 0 0;
    padding: 0;
    list-style: none;
  }

  .photo-img {
    width: 100%;
    height: auto;
  }

  .related {
    padding-bottom: var(--section);
  }

  .related-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-16);
    margin-bottom: var(--s-32);
  }

  .related-head a {
    font-weight: 560;
  }

  @media (min-width: 64rem) {
    .product {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: start;
      gap: var(--s-64);
    }

    .media {
      position: sticky;
      top: calc(var(--header-space) + var(--s-24));
      transition: top 280ms cubic-bezier(0.3, 0.7, 0.2, 1);
    }

    .photos ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .photos li:only-child {
      grid-column: 1 / -1;
    }
  }
</style>
