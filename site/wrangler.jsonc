// Cloudflare Worker: the built site in dist/ plus the inquiry handler in worker/index.js.
// Secrets (set with `npx wrangler secret put NAME`, never in this file):
//   RESEND_API_KEY    email sending
//   SALES_EMAIL       where inquiries go (comma-separated for several)
//   TURNSTILE_SECRET  spam check, pairs with PUBLIC_TURNSTILE_SITEKEY at build time
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dulifei-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // The real domain (both names). Attached as custom domains: Cloudflare adds the DNS records itself.
  "routes": [
    { "pattern": "dlifei.com", "custom_domain": true },
    { "pattern": "www.dlifei.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dulifei-inquiries",
      "database_id": "2d7a2ffd-c786-4374-88c8-05d0ad33daa0",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Sending address on the verified subdomain updates.dlifei.com (Resend).
    "FROM_EMAIL": "Dulifei website <website@updates.dlifei.com>",
    "SITE_URL": "https://dlifei.com"
  },
  "observability": { "enabled": true }
}
